{
  "name": "office-coding-agent",
  "version": "0.5.19",
  "private": true,
  "main": "src/tray/main.cjs",
  "description": "Office coding agent add-in with host-routed AI chat",
  "license": "MIT",
  "imports": {
    "#vscode-jsonrpc": {
      "browser": "vscode-jsonrpc/browser",
      "node": "vscode-jsonrpc/node",
      "default": "vscode-jsonrpc/browser"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev": "node scripts/kill-port.mjs && node --import ./scripts/esm-resolve.mjs src/server.mjs",
    "start:prod-server": "node --import ./scripts/esm-resolve.mjs src/server-prod.mjs",
    "start:dev:desktop": "node scripts/start-dev-desktop.mjs --app excel",
    "start:dev:desktop:excel": "node scripts/start-dev-desktop.mjs --app excel",
    "start:dev:desktop:ppt": "node scripts/start-dev-desktop.mjs --app powerpoint",
    "start:dev:desktop:powerpoint": "node scripts/start-dev-desktop.mjs --app powerpoint",
    "start:dev:desktop:word": "node scripts/start-dev-desktop.mjs --app word",
    "start:dev:desktop:outlook": "node scripts/start-dev-desktop.mjs --app outlook",
    "start:tray": "npm run build && electron .",
    "start:tray:desktop": "node scripts/start-tray-desktop.mjs",
    "stop:tray:desktop": "node scripts/stop-tray-desktop.mjs",
    "build:installer": "npm run build && electron-builder",
    "build:installer:win": "npm run build && electron-builder --win",
    "build:installer:mac": "npm run build && electron-builder --mac",
    "build:installer:dir": "npm run build && electron-builder --dir",
    "start": "office-addin-debugging start manifests/manifest.dev.xml",
    "start:desktop": "office-addin-debugging start manifests/manifest.dev.xml desktop --app excel",
    "start:desktop:excel": "office-addin-debugging start manifests/manifest.dev.xml desktop --app excel",
    "start:desktop:ppt": "office-addin-debugging start manifests/manifest.dev.xml desktop --app powerpoint",
    "start:desktop:word": "office-addin-debugging start manifests/manifest.dev.xml desktop --app word",
    "start:desktop:outlook": "office-addin-debugging start manifests/manifest.outlook.dev.xml desktop --app outlook",
    "start:excel": "office-addin-debugging start manifests/manifest.dev.xml desktop --app excel",
    "start:word": "office-addin-debugging start manifests/manifest.dev.xml desktop --app word",
    "start:powerpoint": "office-addin-debugging start manifests/manifest.dev.xml desktop --app powerpoint",
    "start:outlook": "office-addin-debugging start manifests/manifest.outlook.dev.xml desktop --app outlook",
    "start:tray:excel": "node scripts/start-tray-desktop.mjs --app excel",
    "start:tray:ppt": "node scripts/start-tray-desktop.mjs --app powerpoint",
    "start:tray:word": "node scripts/start-tray-desktop.mjs --app word",
    "stop": "office-addin-debugging stop manifests/manifest.dev.xml && node scripts/kill-port.mjs",
    "dev:start": "node scripts/start-dev-server.mjs",
    "dev:stop": "node scripts/kill-port.mjs",
    "extensions:samples": "node scripts/generate-extension-samples.mjs",
    "sideload:share:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/sideload/setup-local-share.ps1",
    "sideload:share:trust": "powershell -ExecutionPolicy Bypass -File ./scripts/sideload/trust-local-share.ps1",
    "sideload:share:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/sideload/publish-manifest.ps1",
    "sideload:share:publish:outlook": "powershell -ExecutionPolicy Bypass -File ./scripts/sideload/publish-manifest.ps1 -ManifestPath manifests/manifest.outlook.staging.xml",
    "sideload:share:cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/sideload/remove-local-share.ps1",
    "register:win": "powershell -ExecutionPolicy Bypass -File ./scripts/register.ps1",
    "unregister:win": "powershell -ExecutionPolicy Bypass -File ./scripts/unregister.ps1",
    "register:mac": "bash ./scripts/register.sh",
    "unregister:mac": "bash ./scripts/unregister.sh",
    "validate": "office-addin-manifest validate manifests/manifest.dev.xml",
    "validate:outlook": "office-addin-manifest validate manifests/manifest.outlook.dev.xml",
    "validate:staging": "office-addin-manifest validate manifests/manifest.staging.xml",
    "validate:outlook:staging": "office-addin-manifest validate manifests/manifest.outlook.staging.xml",
    "validate:prod": "office-addin-manifest validate manifests/manifest.prod.xml",
    "lint": "oxlint --config .oxlintrc.json src/",
    "lint:fix": "oxlint --config .oxlintrc.json --fix src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test",
    "test:e2e": "npx tsx ./node_modules/mocha/bin/mocha --extension ts tests-e2e/runner.test.ts",
    "test:e2e:ppt": "npx tsx ./node_modules/mocha/bin/mocha --extension ts tests-e2e-ppt/runner.test.ts",
    "test:e2e:word": "npx tsx ./node_modules/mocha/bin/mocha --extension ts tests-e2e-word/runner.test.ts",
    "test:e2e:outlook": "npx tsx ./node_modules/mocha/bin/mocha --extension ts tests-e2e-outlook/runner.test.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:ppt && npm run test:e2e:word && npm run test:e2e:outlook",
    "audit:tools:bootstrap": "npx tsx scripts/bootstrap-tool-coverage-map.ts",
    "audit:tools": "npx tsx scripts/check-tool-coverage.ts",
    "audit:tools:strict": "npx tsx scripts/check-tool-coverage.ts --strict",
    "manifest": "npx tsx scripts/generate-manifest.ts",
    "runtime-logging-enable": "office-addin-dev-settings runtime-log --enable",
    "runtime-logging-disable": "office-addin-dev-settings runtime-log --disable",
    "runtime-logging-show": "office-addin-dev-settings runtime-log",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@github/copilot": "^1.0.86",
    "@github/copilot-sdk": "^1.0.14",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/office-runtime": "^1.0.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "skillpm": "^1.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vscode-jsonrpc": "^9.0.2",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/office-js": "^1.0.609",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vscode/codicons": "^0.0.46-24",
    "dotenv": "^18.0.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "mocha": "^12.0.2",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-dev-settings": "^4.0.0",
    "office-addin-mock": "^4.0.0",
    "oxlint": "^1.83.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@noble/hashes": "2.4.0",
    "serialize-javascript": "7.1.1",
    "adm-zip": "0.6.1",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.4.2",
    "tmp": "0.2.7",
    "uuid": "14.0.2",
    "image-size": "2.0.4"
  },
  "build": {
    "appId": "com.officecodingagent.tray",
    "productName": "Office Coding Agent",
    "directories": {
      "output": "build/electron"
    },
    "files": [
      "dist/**/*",
      "src/tray/**/*",
      "src/server-prod.mjs",
      "src/copilotProxy.mjs",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --config .oxlintrc.json --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  }
}
